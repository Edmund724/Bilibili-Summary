{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": [
    "extension/**/*.js",
    "extension/**/*.ts",
    "tests/**/*.js",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "extension/entry/content-classic.js"]
}
