{
  "name": "bilibili-summary",
  "version": "2.0.0",
  "description": "Bilibili 视频字幕抓取与 AI 总结浏览器扩展",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "build:content": "node scripts/build-content.js",
    "build:release": "python3 scripts/build_release.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:run": "node_modules/.bin/esbuild eval/run.ts --bundle --platform=node --format=esm --outfile=eval/run.mjs && node eval/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edmund724/Bilibili-Summary.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Edmund724/Bilibili-Summary/issues"
  },
  "homepage": "https://github.com/Edmund724/Bilibili-Summary#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
