{
  "manifest_version": 3,
  "name": "Bilibili-Summary｜一键总结B站视频",
  "version": "1.1.4",
  "description": "在 B 站视频页抓取字幕，预览后复制或下载。",
  "browser_specific_settings": {
    "gecko": {
      "id": "bilibili-summary@github.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "entry/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "options_page": "pages/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/watchlater",
        "https://www.bilibili.com/list/watchlater/",
        "https://www.bilibili.com/list/watchlater/*"
      ],
      "js": ["entry/content-classic.js"],
      "css": ["entry/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Bilibili-Summary｜一键总结B站视频",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "pages/popup.html"
  }
}
